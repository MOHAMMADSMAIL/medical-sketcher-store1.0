NODE_ENV=development
API_PORT=3000
WEB_URL=http://localhost:3001
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
AUTH_SECRET=replace-with-development-secret
AUTH_COOKIE_NAME=aurelia_session
DATABASE_URL=postgresql://aurelia:change-me@localhost:5432/aurelia_books?schema=public
AUTH_SESSION_DAYS=30
PAYMENT_PROVIDER=development
PAYMENT_SECRET=replace-in-secret-manager
PAYMENT_WEBHOOK_SECRET=replace-with-development-webhook-secret
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
EMAIL_PROVIDER=console
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-secret
