# ─── Runtime ────────────────────────────────────────────────────────────────
# development | production — changes cookie security + rate-limit fail policy
NODE_ENV=development
# Port the API listens on (Fly.io sets this to 8080 automatically)
API_PORT=3000
# Public web origin — used for CORS + CSRF Origin check (Vercel URL in production)
WEB_URL=http://localhost:3001
# Public API base URL (used by web server components)
API_URL=http://localhost:3000
# Same as API_URL but readable by the browser bundle
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Auth ───────────────────────────────────────────────────────────────────
# Secret used to derive session token hashes — generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-development-secret
# Session cookie name
AUTH_COOKIE_NAME=aurelia_session
# Session lifetime in days
AUTH_SESSION_DAYS=30

# ─── Database (source: Supabase project → Settings → Database → Connection string) ──
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres?schema=public&sslmode=require

# ─── Payments (source: HyperPay merchant portal after registration) ─────────
# development = built-in sandbox provider (no real money) | hyperpay = live gateway
PAYMENT_PROVIDER=development
# TEST: https://test.oppwa.com   LIVE: https://eu-prod.oppwa.com  (default is TEST on purpose)
HYPERPAY_BASE_URL=https://test.oppwa.com
# HyperPay portal → Administration → Entity IDs (a.k.a. "Channel ID")
HYPERPAY_ENTITY_ID=replace-with-hyperpay-entity-id
# HyperPay portal → User Management → API user password
HYPERPAY_ACCESS_TOKEN=replace-with-hyperpay-access-token
# DB = debit/purchase (keep as-is for one-step checkout)
HYPERPAY_PAYMENT_TYPE=DB

# ─── Storage (source: Supabase project → Settings → API + Storage) ──────────
# local = dev disk | supabase = private bucket with signed URLs
STORAGE_PROVIDER=local
# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project.supabase.co
# SERVICE ROLE key — SERVER ONLY, never expose to the browser (Settings → API)
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Name of the private bucket you created in Supabase Storage
SUPABASE_STORAGE_BUCKET=books-private
# Signed download URL lifetime in seconds
STORAGE_SIGNED_URL_TTL=300
# Local storage root when STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage

# ─── Email (source: resend.com dashboard → API Keys) ────────────────────────
# console = log to server output (dev) | resend = real delivery
EMAIL_PROVIDER=console
# Create at resend.com/api-keys
RESEND_API_KEY=replace-with-resend-api-key
# Must be a verified sender/domain in your Resend account
EMAIL_FROM=Aurelia Books <verified-sender@example.com>

# ─── Distributed rate limiting (source: upstash.com console → Redis → REST) ─
# Empty = no-op in development (fails closed with 503 in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Error monitoring (source: sentry.io → project settings → Client Keys) ──
# Empty = errors only logged to server output with redaction applied
SENTRY_DSN=

# ─── DRM / download policy (owner decision: 5 downloads, 1-year access) ─────
DOWNLOAD_MAX_COUNT=5
DOWNLOAD_ACCESS_DAYS=365
DOWNLOAD_WATERMARK_LABEL=نسخة مرخّصة

# ─── Legacy owner bootstrap (kept from earlier delivery) ────────────────────
OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-secret
